POSTGRES_DB=photodrop
POSTGRES_USER=photodrop
POSTGRES_PASSWORD=photodrop_dev
DATABASE_URL=postgres://photodrop:photodrop_dev@postgres:5432/photodrop?sslmode=disable

MINIO_ROOT_USER=photodrop
MINIO_ROOT_PASSWORD=photodrop_dev_secret
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=photodrop
S3_SECRET_KEY=photodrop_dev_secret
S3_BUCKET=photodrop-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_USE_SSL=false
S3_PRESIGN_TTL=15m

HTTP_ADDR=:8080
CLEANUP_INTERVAL=1m
THUMBNAIL_INTERVAL=2s
ARCHIVE_INTERVAL=2s
SHUTDOWN_TIMEOUT=10s
AUTH_ACCESS_SECRET=local_development_secret_change_me_32_chars
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_ISSUER=photodrop

# Optional until a Telegram bot is connected. Never expose this token to the frontend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL=1h

# Optional: one-off key for the isolated Tailscale preview container.
TAILSCALE_AUTHKEY=
